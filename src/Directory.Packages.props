<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="DocumentFormat.OpenXml" Version="3.5.1" />
    <PackageVersion Include="MarkdownSnippets.MsBuild" Version="28.5.0" />
    <PackageVersion Include="NodaTime" Version="3.3.5" />
    <PackageVersion Include="ProjectDefaults" Version="1.0.184" />
    <PackageVersion Include="ProjectFiles" Version="1.6.0" />
    <PackageVersion Include="Polyfill" Version="11.4.3" />
    <PackageVersion Include="Sbom" Version="0.3.1" />
    <PackageVersion Include="System.Collections.Immutable" Version="10.0.12" />
    <PackageVersion Include="System.IO.Compression" Version="4.3.0" />
    <PackageVersion Include="Verify" Version="33.3.2-beta.1" />
    <PackageVersion Include="Verify.MailMessage" Version="1.1.1" />
    <PackageVersion Include="Verify.TUnit" Version="33.3.2-beta.1" />
    <PackageVersion Include="TUnit" Version="1.72.16" />
    <PackageVersion Include="Argon" Version="0.38.0" />
    <PackageVersion Include="DiffEngine" Version="20.7.0" />
    <PackageVersion Include="EmptyFiles" Version="8.20.0" />
    <PackageVersion Include="SimpleInfoName" Version="3.2.0" />
    <!-- CVE -->
    <PackageVersion Include="System.IO.Packaging" Version="10.0.12" />
  </ItemGroup>
</Project>